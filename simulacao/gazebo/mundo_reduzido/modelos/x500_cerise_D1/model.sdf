<?xml version="1.0"?>
<sdf version="1.9">
  <model name="x500_cerise_D1">
    <include merge="true"><uri>model://x500</uri></include>
    <link name="camera_link">
      <pose>0 0 -0.05 0 0 0</pose>
      <inertial><mass>0.02</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia></inertial>
      
      <sensor name="camera_nadir" type="camera">
        <pose>0 0 -0.08 0 1.570796 0</pose>
        <camera>
          <horizontal_fov>1.221730</horizontal_fov>
          <image><width>1280</width><height>960</height><format>R8G8B8</format></image>
          <clip><near>0.3</near><far>3000</far></clip>
        </camera>
        <always_on>1</always_on><update_rate>5.0</update_rate><visualize>false</visualize>
        <topic>/cerise/D1/camera</topic>
      </sensor>
      <sensor name="caixas_nadir" type="boundingbox_camera">
        <pose>0 0 -0.08 0 1.570796 0</pose>
        <topic>/cerise/D1/caixas</topic>
        <camera>
          <box_type>2d</box_type>
          <horizontal_fov>1.221730</horizontal_fov>
          <image><width>1280</width><height>960</height></image>
          <clip><near>0.3</near><far>3000</far></clip>
        </camera>
        <always_on>1</always_on><update_rate>5.0</update_rate>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>
  </model>
</sdf>
